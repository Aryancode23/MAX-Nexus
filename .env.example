# Copy this file to .env.local and fill in your real values from your Supabase project.
# Supabase Dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — NEVER prefix with NEXT_PUBLIC_, never expose to the browser.
# Supabase Dashboard -> Project Settings -> API -> "service_role" secret key.
# Used only in src/lib/supabase/admin.ts for login rate-limiting and the
# immutable activity log — see supabase/phase6-schema.sql.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Optional but recommended — random string, protects /api/cron/keep-alive
# from being called by anyone else. Vercel automatically sends it as a
# Bearer token when it triggers the cron job (set it in Vercel too, under
# Environment Variables, with the exact same value).
CRON_SECRET=generate-a-random-string-here
